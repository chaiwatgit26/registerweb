@model List<RegisterWeb.Models.Occupation>

<style>
    .register-container {
        width: 760px;
        margin: 20px auto;
        border: 2px solid #222;
    }

    .register-header {
        background-color: #00b050;
        border-bottom: 2px solid #222;
        text-align: center;
        padding: 7px;
        font-size: 14px;
    }

    .register-form {
        padding: 30px 60px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 55px;
        row-gap: 8px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group label {
        margin-bottom: 7px;
        font-size: 14px;
    }

    .form-control {
        height: 36px;
        box-sizing: border-box;
        border: 1px solid #888;
        padding: 5px;
    }

    .validation-message {
        color: red;
        font-size: 11px;
        min-height: 16px;
        margin-top: 4px;
    }

    .full-width {
        grid-column: 1 / 3;
    }

    .sex-group {
        display: flex;
        align-items: center;
        gap: 55px;
        margin-top: 5px;
    }

    .sex-option {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .button-area {
        display: flex;
        justify-content: center;
        gap: 55px;
        margin-top: 25px;
    }

    .btn {
        width: 108px;
        height: 39px;
        border: none;
        border-radius: 7px;
        color: white;
        font-size: 14px;
        cursor: pointer;
    }

    .btn-save {
        background-color: #70ad47;
    }

    .btn-clear {
        background-color: #999999;
    }
</style>

<div class="register-container">

    <div class="register-header">
        IT 04-1
    </div>

    <div class="register-form">

        @if (TempData["Message"] != null)
        {
            <div style="color: green; margin-bottom: 15px;">
                @TempData["Message"]
            </div>
        }

        <form asp-controller="Register"
              asp-action="Create"
              method="post">

            <div class="form-grid">

                <!-- First Name -->
                <div class="form-group">
                    <label>First Name</label>

                    <input type="text"
                           name="FirstName"
                           class="form-control" />

                    <div class="validation-message">
                        @Html.ValidationMessage("FirstName")
                    </div>
                </div>


                <!-- Last Name -->
                <div class="form-group">
                    <label>Last Name</label>

                    <input type="text"
                           name="LastName"
                           class="form-control" />

                    <div class="validation-message">
                        @Html.ValidationMessage("LastName")
                    </div>
                </div>


                <!-- Email -->
                <div class="form-group">
                    <label>Email</label>

                    <input type="email"
                           name="Email"
                           class="form-control" />

                    <div class="validation-message">
                        @Html.ValidationMessage("Email")
                    </div>
                </div>


                <!-- Phone -->
                <div class="form-group">
                    <label>Phone</label>

                    <input type="text"
                           name="Phone"
                           class="form-control" />

                    <div class="validation-message">
                        @Html.ValidationMessage("Phone")
                    </div>
                </div>


                <!-- Profile -->
                <div class="form-group">
                    <label>Profile</label>

                    <input type="text"
                           name="Profile"
                           class="form-control" />

                    <div class="validation-message">
                        @Html.ValidationMessage("Profile")
                    </div>
                </div>


                <!-- Birth Date -->
                <div class="form-group">
                    <label>Birth Day</label>

                    <input type="date"
                           name="BirthDate"
                           class="form-control" />

                    <div class="validation-message">
                        @Html.ValidationMessage("BirthDate")
                    </div>
                </div>


                <!-- Occupation -->
                <div class="form-group">
                    <label>Occupation</label>

                    <select name="OccupationId"
                            class="form-control">

                        <option value="0">
                            -- Select Occupation --
                        </option>

                        @foreach (var occupation in Model)
                        {
                            <option value="@occupation.Id">
                                @occupation.Name
                            </option>
                        }

                    </select>

                    <div class="validation-message">
                        @Html.ValidationMessage("OccupationId")
                    </div>
                </div>


                <!-- Sex -->
                <div class="form-group">
                    <label>Sex</label>

                    <div class="sex-group">

                        <label class="sex-option">
                            <input type="radio"
                                   name="Sex"
                                   value="Male" />
                            Male
                        </label>

                        <label class="sex-option">
                            <input type="radio"
                                   name="Sex"
                                   value="Female" />
                            Female
                        </label>

                    </div>

                    <div class="validation-message">
                        @Html.ValidationMessage("Sex")
                    </div>
                </div>

            </div>


            <!-- Buttons -->
            <div class="button-area">

                <button type="submit"
                        class="btn btn-save">
                    Save
                </button>

                <button type="reset"
                        class="btn btn-clear">
                    Clear
                </button>

            </div>

        </form>

    </div>
</div>